# Copy this file to .env and fill in real values. .env is gitignored.

# --- Google Photos downloader (scripts/download_google_photos.py) ---
# Path to your OAuth client secret JSON (downloaded from Google Cloud Console).
GOOGLE_CLIENT_SECRET=credentials/sa1.json
# Where the OAuth token is cached after first login.
GOOGLE_TOKEN_FILE=credentials/token.json

# --- Telegram downloader (scripts/download_telegram.py) ---
# Get these from https://my.telegram.org
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
